# Copy to .env.local and fill in at least one key.
#
# These are read only in src/lib/providers/adapter.ts, which runs on the server.
# None of them is prefixed NEXT_PUBLIC_, so none can reach the browser.
#
# Any provider you leave blank is dropped from the model list and from the
# fallback chain, so the app still runs with only one key configured.

# Google AI Studio — https://aistudio.google.com/apikey  (free tier available)
GOOGLE_GENERATIVE_AI_API_KEY=

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
