{
  "name": "nimbusstack-knowledge-chatbot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:index && next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:index": "tsx --env-file-if-exists=.env.local scripts/build-index.ts",
    "eval": "tsx --env-file-if-exists=.env.local scripts/eval.ts",
    "eval:audit": "tsx scripts/audit-eval.ts",
    "pretest": "npm run build:index"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.80",
    "@ai-sdk/google": "^4.0.96",
    "@ai-sdk/openai": "^4.0.94",
    "ai": "^7.0.141",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
