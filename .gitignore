# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep the example env file tracked despite the .env* rule above
!.env.example

# assessment source material, not part of the deliverable
CodeShip-Technical-Assessment.pdf
nimbusstack-knowledge-base.zip

# the built search index — generated by `npm run build:index`, never committed,
# so that a fresh clone cannot have a stale one
/data/
